{
  "rewrites": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "p.elevaris.app"
        }
      ],
      "destination": "/p/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "p.elevaris.app"
        }
      ],
      "destination": "/p"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "ops.elevaris.app"
        }
      ],
      "destination": "/:path*"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "ops.elevaris.app"
        }
      ],
      "destination": "/preview"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}

